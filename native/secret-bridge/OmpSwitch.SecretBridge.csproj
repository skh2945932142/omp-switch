<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>omp-switch-secret</AssemblyName>
    <RootNamespace>OmpSwitch.SecretBridge</RootNamespace>
    <!--
      OMP runs an `apiKey: '!<command>'` reference with a hard 10s timeout and silently drops the
      key when the command is slower, so cold start is a correctness constraint here, not a nicety.
      Native AOT starts in tens of milliseconds and does not unpack itself to a temp directory the
      way PublishSingleFile + SelfContained does on first run.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
